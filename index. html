<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self' https://tailwindcss.com https://cloudflare.com https://unpkg.com https://jsdelivr.net https://*.supabase.co https://googleapis.com https://gstatic.com; style-src 'self' 'unsafe-inline' https://tailwindcss.com https://googleapis.com; font-src 'self' https://gstatic.com; script-src 'self' 'unsafe-inline' https://tailwindcss.com https://cloudflare.com https://unpkg.com https://jsdelivr.net; img-src 'self' data: blob:;">
    <title>نادي VIP | نظام الولاء والحجوزات الذكي</title>
    <link href="https://googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <script src="https://tailwindcss.com"></script>
    <script src="https://cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="https://unpkg.com"></script>
    <script src="https://jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="https://jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        body { font-family: 'Cairo', sans-serif; }
        .holo-card { transition: transform 0.15s ease-out; transform-style: preserve-3d; }
        .holo-shine { background: radial-gradient(circle at var(--x, 50%) var(--y, 50%), rgba(255,255,255,0.2) 0%, transparent 60%); }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen">

    <!-- شريط الساعة السعيدة -->
    <div id="happyHourBanner" class="hidden bg-gradient-to-r from-amber-500 via-orange-500 to-rose-500 text-slate-950 text-center py-2 px-4 text-xs font-black animate-pulse">
        🔥 الساعة السعيدة (HAPPY HOUR) مفعّلة الآن! احصل على أختام مضاعفة (2X) عند المسح عند الكاشير! 🔥
    </div>

    <!-- القائمة العلوية -->
    <nav class="bg-black/80 backdrop-blur-md px-4 py-3 border-b border-slate-800 sticky top-0 z-50">
        <div class="max-w-6xl mx-auto flex flex-wrap justify-between items-center gap-2">
            <div class="flex items-center gap-2">
                <span class="bg-gradient-to-r from-amber-400 to-emerald-400 text-black font-black px-2.5 py-1 rounded text-xs">VIP CLUB</span>
                <span class="font-bold text-sm md:text-base text-white">الحجوزات وبطاقة الولاء</span>
            </div>
            <div class="flex gap-2">
                <button onclick="switchTab('customer')" class="bg-indigo-600 hover:bg-indigo-500 px-3 py-1.5 rounded-lg text-xs font-bold transition">✨ بطاقتي VIP</button>
                <button onclick="switchTab('admin')" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 px-3 py-1.5 rounded-lg text-xs font-bold transition">🔐 لوحة الكاشير</button>
            </div>
        </div>
    </nav>

    <div class="max-w-6xl mx-auto p-4 md:p-6">

        <!-- 1. واجهة العميل -->
        <div id="customerView" class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
            
            <!-- نموذج الحجز -->
            <div class="bg-slate-900/90 p-6 rounded-3xl border border-slate-800 shadow-2xl">
                <h2 class="text-xl font-bold text-white mb-1">احجز موعدك واحصل على بطاقة VIP</h2>
                <p class="text-slate-400 text-xs mb-5">سجّل بكود دعوة من صديق واحصل فوراً على ختم إضافي مجاني (+1)!</p>

                <form onsubmit="createBooking(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-400 mb-1">الاسم الكامل</label>
                        <input type="text" id="custName" required minlength="2" maxlength="50" placeholder="مثال: أحمد الحلبي" class="w-full bg-slate-950 border border-slate-700 text-white rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-emerald-500">
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-400 mb-1">رقم الهاتف (واتساب)</label>
                            <input type="tel" id="custPhone" required pattern="[0-9+\s()-]{7,20}" placeholder="09XX XXX XXX" dir="ltr" class="w-full bg-slate-950 border border-slate-700 text-white text-right rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-emerald-500">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-amber-400 mb-1">🎁 كود الدعوة (اختياري)</label>
                            <input type="text" id="usedReferralCode" maxlength="10" placeholder="VIP-XXXX" dir="ltr" class="w-full bg-slate-950 border border-amber-500/40 text-amber-300 uppercase text-right rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-amber-400">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-400 mb-1">اختر الخدمة</label>
                        <select id="serviceSelect" class="w-full bg-slate-950 border border-slate-700 text-white rounded-xl px-4 py-2.5 text-sm">
                            <option value="حلاقة وعناية كاملة">حلاقة وعناية كاملة</option>
                            <option value="تنظيف بشرة VIP">تنظيف بشرة VIP</option>
                            <option value="قهوة مختصة وحلويات">قهوة مختصة وحلويات</option>
                        </select>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-400 mb-1">التاريخ</label>
                            <input type="date" id="bookDate" required class="w-full bg-slate-950 border border-slate-700 text-white rounded-xl px-4 py-2.5 text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-400 mb-1">الوقت</label>
                            <select id="bookTime" class="w-full bg-slate-950 border border-slate-700 text-white rounded-xl px-4 py-2.5 text-sm">
                                <option>10:30 ص</option>
                                <option>01:00 م</option>
                                <option>03:30 م</option>
                                <option>06:00 م</option>
                                <option>08:30 م</option>
                            </select>
                        </div>
                    </div>

                    <button type="submit" id="submitBtn" class="w-full bg-gradient-to-r from-emerald-500 to-teal-400 hover:opacity-95 text-slate-950 font-black py-3.5 rounded-xl shadow-lg transition text-sm">
                        ✨ تأكيد الحجز وإصدار بطاقة VIP
                    </button>
                </form>

                <!-- صندوق مشاركة كود الدعوة -->
                <div id="referralShareBox" class="hidden mt-5 p-4 rounded-2xl bg-indigo-950/50 border border-indigo-500/30 space-y-3">
                    <div class="flex justify-between items-center">
                        <div>
                            <span class="text-[11px] text-indigo-300 font-bold">كود الدعوة الخاص بك للأصدقاء</span>
                            <div class="text-lg font-black text-white font-mono" id="myReferralCodeDisplay" dir="ltr">-</div>
                        </div>
                        <button onclick="copyReferralCode()" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold px-3 py-2 rounded-xl">نسخ الكود</button>
                    </div>
                    <p class="text-xs text-slate-300">شارك هذا الكود مع أصدقائك؛ عند أول حجز لهم ستحصل أنت وصديقك على <strong>+1 ختم إضافي مجاناً</strong>!</p>
                    <a id="whatsappLink" target="_blank" class="w-full flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#20bd5a] text-slate-950 font-bold py-2.5 rounded-xl text-xs transition">
                        📲 إرسال البطاقة وكود الدعوة عبر واتساب
                    </a>
                </div>
            </div>

            <!-- البطاقة الرقمية ثلاثية الأبعاد -->
            <div class="space-y-4">
                <div class="flex justify-between items-center px-1">
                    <span class="text-xs font-bold text-slate-400">بطاقتك الرقمية التفاعلية (3D)</span>
                    <span id="qrTimerBadge" class="text-xs font-mono bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-2.5 py-0.5 rounded-full">تحديث QR: 30ث</span>
                </div>

                <div id="holoCard" onmousemove="tiltCard(event)" onmouseleave="resetCard()" class="holo-card relative overflow-hidden bg-gradient-to-br from-slate-900 via-indigo-950 to-black p-6 rounded-3xl border border-indigo-500/30 shadow-2xl cursor-pointer">
                    <div class="holo-shine absolute inset-0 pointer-events-none"></div>
                    
                    <div class="relative z-10 flex justify-between items-start">
                        <div>
                            <span id="vipTierBadge" class="text-[11px] bg-amber-500/20 text-amber-300 border border-amber-500/40 px-2.5 py-0.5 rounded-full font-black">🥉 عضو برونزي</span>
                            <h3 class="text-2xl font-black text-white mt-2" id="cardHolderName">بانتظار إنشاء البطاقة</h3>
                            <p class="text-xs text-slate-400 mt-0.5" id="cardHolderPhone" dir="ltr">احجز موعداً لتفعيل بطاقتك</p>
                        </div>
                        <div class="bg-white p-2 rounded-2xl shadow-xl" id="qrcode"></div>
                    </div>

                    <div class="relative z-10 grid grid-cols-6 gap-2.5 my-7" id="cardStamps"></div>

                    <div class="relative z-10 flex justify-between items-center border-t border-white/10 pt-4 text-xs">
